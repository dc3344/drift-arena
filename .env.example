# Optional public Discord application/client ID. Never put a client secret here.
# Browser play works with this empty. Restart dev or rebuild after env changes.
VITE_DISCORD_CLIENT_ID=

# Optional WebSocket endpoint override. Leave empty for same-origin /ws;
# inside Discord's proxy, the default becomes /.proxy/ws automatically.
# A deployed Discord Activity must use a mapped same-origin endpoint.
# Examples: /ws, /.proxy/ws, wss://your-game.example/ws
VITE_WS_URL=
